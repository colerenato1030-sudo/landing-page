{
  "plugins": {
    "omniroute": {
      "enabled": true,
      "version": "1.0.0",
      "description": "OmniRoute AI gateway plugin for unified LLM routing",
      "config": "./.claude/plugins/omniroute/config.json"
    }
  },
  "omniroute": {
    "enabled": true,
    "apiEndpoint": "http://localhost:8080",
    "autoStart": false,
    "models": {
      "default": "claude-3-5-sonnet-20241022",
      "fallback": "claude-3-haiku-20240307"
    },
    "features": {
      "autoFallback": true,
      "contextCompression": true,
      "requestCaching": true,
      "healthChecks": true
    }
  },
  "environment": {
    "NODE_ENV": "production"
  }
}
