# OmniRoute Plugin Environment Variables
# Copy this file to .env and fill in your actual API keys
# WARNING: Never commit the .env file with real API keys to version control!

# ==========================================
# LLM Provider API Keys
# ==========================================

# Anthropic Claude API Key
# Get it from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key
# Get it from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini API Key
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=...

# Cohere API Key (optional)
# Get it from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=...

# Hugging Face API Token (optional)
# Get it from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=...

# ==========================================
# OmniRoute Server Configuration
# ==========================================

# Server port
OMNIROUTE_PORT=8080

# Server host
OMNIROUTE_HOST=localhost

# Log level: error, warn, info, debug, trace
OMNIROUTE_LOG_LEVEL=info

# Enable debug mode (verbose logging)
OMNIROUTE_DEBUG=false

# ==========================================
# Feature Flags
# ==========================================

# Enable auto-fallback between providers
OMNIROUTE_AUTO_FALLBACK=true

# Enable request caching
OMNIROUTE_CACHE_ENABLED=true

# Cache TTL in seconds
OMNIROUTE_CACHE_TTL=3600

# Enable context compression
OMNIROUTE_COMPRESSION_ENABLED=true

# Enable health checks
OMNIROUTE_HEALTH_CHECK_ENABLED=true

# Health check interval in milliseconds
OMNIROUTE_HEALTH_CHECK_INTERVAL=60000

# ==========================================
# Timeouts and Retries
# ==========================================

# Request timeout in milliseconds
OMNIROUTE_TIMEOUT=30000

# Number of retry attempts
OMNIROUTE_RETRIES=3

# Backoff multiplier for retries
OMNIROUTE_BACKOFF_MULTIPLIER=2

# ==========================================
# Model Configuration
# ==========================================

# Primary model
OMNIROUTE_PRIMARY_MODEL=claude-3-5-sonnet-20241022

# Fallback model
OMNIROUTE_FALLBACK_MODEL=claude-3-haiku-20240307

# ==========================================
# Advanced Options
# ==========================================

# Custom OmniRoute endpoint (if self-hosted)
OMNIROUTE_ENDPOINT=http://localhost:8080

# Enable MCP (Model Context Protocol)
OMNIROUTE_MCP_ENABLED=false

# Enable A2A (Agent-to-Agent) communication
OMNIROUTE_A2A_ENABLED=false

# Custom provider configuration JSON path
OMNIROUTE_PROVIDER_CONFIG_PATH=./config.json

# ==========================================
# Claude Code Integration
# ==========================================

# Enable Claude Code integration
CLAUDE_CODE_OMNIROUTE_ENABLED=true

# Claude Code session ID (auto-generated)
CLAUDE_CODE_SESSION_ID=

# Enable Claude Code plugin detection
CLAUDE_CODE_PLUGIN_DETECTION=true
