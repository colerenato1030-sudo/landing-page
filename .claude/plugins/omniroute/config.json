{
  "omniroute": {
    "enabled": true,
    "apiEndpoint": "http://localhost:8080",
    "models": {
      "primary": "claude-3-5-sonnet-20241022",
      "fallback": "claude-3-haiku-20240307",
      "custom": []
    },
    "routing": {
      "strategy": "auto-fallback",
      "healthCheck": true,
      "healthCheckInterval": 60000,
      "timeout": 30000,
      "retries": 3
    },
    "features": {
      "compression": {
        "enabled": true,
        "algorithm": "rtk+caveman"
      },
      "cacheing": {
        "enabled": true,
        "ttl": 3600
      },
      "logging": {
        "enabled": true,
        "level": "info",
        "format": "json"
      }
    },
    "providers": {
      "anthropic": {
        "enabled": true,
        "apiKey": "${ANTHROPIC_API_KEY}",
        "priority": 1
      },
      "openai": {
        "enabled": true,
        "apiKey": "${OPENAI_API_KEY}",
        "priority": 2
      },
      "gemini": {
        "enabled": true,
        "apiKey": "${GEMINI_API_KEY}",
        "priority": 3
      }
    }
  }
}
